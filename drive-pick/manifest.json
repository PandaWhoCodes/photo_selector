{
  "manifest_version": 3,
  "name": "Drive Photo Picker",
  "version": "1.0.0",
  "description": "Select photos while browsing Google Drive, then copy the list of filenames and links to send to your photographer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://drive.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Selected photos"
  },
  "commands": {
    "toggle-pick": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Select / unselect the photo open in Drive"
    }
  }
}
